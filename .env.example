# Copy to .env.local. Server only; never use NEXT_PUBLIC_ for these keys.
# Visit Seoul API only: api-call.visitseoul.net (VISITSEOUL-API-KEY header).
VISITSEOUL_API_KEY=
# Seoul Open Data only: openapi.seoul.go.kr. Select with --source=seoul-open-data.
# Without this key, that source uses Seoul Open Data public JSON downloads.
SEOUL_API_KEY=
# Approvals required for KMA forecasts and Seoul transit.
DATA_GO_KR_KEY=
PLACE_DB_PATH=data/places.sqlite
